# Copy to config.env on Linux and fill the required values before running.
D9_BIN="/absolute/path/to/drive9-main-COMMIT"
D9_TARGET_VERSION="main-COMMIT"
D9_SERVER="https://drive9.example.invalid"
# Authentication: an existing drive9 context or DRIVE9_API_KEY, outside this kit.
DRIVE9_SERVER="$D9_SERVER"
D9_NODE_BIN="/absolute/path/to/node-v22.13.0-linux-x64/bin"
# Use a fresh run ID. Keep state/tools/cache/results on the local filesystem.
D9_RUN_ID="gcp-YYYYMMDD-COMMIT-r01"
D9_STATE="$HOME/drive9-replays/$D9_RUN_ID/state"
D9_RESULTS="$HOME/drive9-replays/$D9_RUN_ID/results"
D9_FIXTURES="$D9_STATE/fixtures"
D9_LOCAL="$D9_STATE/local"
D9_MOUNT="/mnt/d9-work"
D9_MOUNT_BASE="/mnt"
D9_REMOTE_ROOT="/"
D9_DURABILITY="auto"
D9_DURABILITY_CONTROL="fsync"
D9_REPLAY_LOCK="$HOME/drive9-replays/coordinator.lock"
# Pin the actual PSC IP after the endpoint is restored (required for injection).
D9_ENDPOINT_IPS=""
npm_config_cache="$D9_STATE/npm-cache"
COREPACK_HOME="$D9_STATE/corepack-home"
# The main mount must use coding-agent. Auxiliary acceptance mounts retain none.
