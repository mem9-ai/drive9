#!/bin/sh
# Scenario 2: a dev server reads immediately after code is saved.
#
# Scope:
#   Once the writer's save succeeds (write + fsync + close returns success), other
#   processes must immediately read the complete new content: no torn reads, no stale
#   content. After an in-place partial overwrite (pwrite shape, length unchanged) a
#   whole-file comparison must pass, and a truncating rewrite must read back
#   consistently. A(128KiB)/B(64KiB) alternate "write temp + atomic rename"
#   replacements of the same path for 30 rounds (last round B) while a concurrent
#   reader process keeps reopening and reading whole: every read must observe
#   complete A or complete B - no mixed content, no wrong length, no path gap caused
#   by the replacement (this is an immediate invariant, not an end-state invariant).
#   A batch of 40 files (4 concurrent workers) each does "copy + append one line";
#   after the whole batch finishes, the final state must match the expectation
#   exactly (the multi-file result is not required to switch as one atomic
#   operation).
#   Mis-readings this scenario forbids:
#   - Treating a stat of the file size by the reader as "reading".
#   - Using "eventual consistency" to excuse mixed content or path gaps observed
#     during the process.
#
# Environment (passed through the run CLI, not scripted here):
#   Inputs: the batch section's expected final state is built independently under
#   /tmp/batch (expectations kept separate from the paths under test); the complete
#   A/B version contents are constructed locally by the script; the reader's polling
#   window is <= 300 iterations (reopen + full read each time).
#   control: this script references control (manifest-equals); the /tmp staging area
#   can be rebuilt on every execution.
#
# BATCH is an ordinary shell variable, overridable through the environment; it is
# exported because the concurrent reader is a separate process.
set -eu
BATCH=${BATCH:-40}
export BATCH

# ---- (1) After the writer does write+fsync+close, another process (an independent
#      child process polling) must immediately see the complete new content; the
#      reader polls within the agreed window and fails once it exceeds it
#      [scenario2-step1 / scenario2-check1] ----
mkdir -p live
printf 'marker-v1\n' > live/marker.txt.part
sync_file() { :; }   # publish shape: write temp + fsync + rename
if command -v fsync >/dev/null 2>&1; then fsync live/marker.txt.part; fi
mv live/marker.txt.part live/marker.txt
# Reader: a separate process; polls within the agreed window and fails once it exceeds it
sh -c '
  i=0
  while [ $i -lt 400 ]; do
    if [ -f live/marker.txt ]; then
      printf "marker-v1\n" > /tmp/expect-marker
      cmp live/marker.txt /tmp/expect-marker && exit 0
      echo TORN-READ; exit 1
    fi
    i=$((i+1)); sleep 0.05
  done
  echo TIMEOUT-VISIBILITY; exit 1
'
echo "cross-process write visible"

# ---- (2) In-place partial overwrite (pwrite shape: 64 bytes overwritten at offset
#      1024, length unchanged) + a truncating rewrite that must read back
#      consistently [scenario2-step2 / scenario2-check3] ----
mkdir -p live
head -c 131072 /dev/zero | tr '\0' 'A' > live/source.txt
dd if=/dev/zero bs=64 count=1 2>/dev/null | tr '\0' 'X' > /tmp/patch
{ head -c 1024 live/source.txt; cat /tmp/patch; tail -c +1089 live/source.txt; } > /tmp/expect-source
dd if=/tmp/patch of=live/source.txt bs=1 seek=1024 conv=notrunc 2>/dev/null
cmp live/source.txt /tmp/expect-source
printf 'short rewrite\n' > live/source.txt.part
if command -v fsync >/dev/null 2>&1; then fsync live/source.txt.part; fi
mv live/source.txt.part live/source.txt
printf 'short rewrite\n' > /tmp/expect-short
cmp live/source.txt /tmp/expect-short
echo "inplace edit readback consistent"

# ---- (3) A(128KiB)/B(64KiB) alternate "write temp + atomic rename" replacements of
#      the same path for 30 rounds (last round B); a concurrent reader keeps
#      reopening and reading whole: every read must observe complete A or complete
#      B, no mixing, no gaps, correct length [scenario2-step3 / scenario2-step4 /
#      scenario2-check2] ----
head -c 131072 /dev/zero | tr '\0' 'A' > /tmp/A.bin
head -c 65536  /dev/zero | tr '\0' 'B' > /tmp/B.bin
# Reader (a separate process)
sh -c '
  w=0
  while [ ! -e live/combined.bin ] && [ $w -lt 2000 ]; do w=$((w+1)); sleep 0.01; done
  i=0
  while [ $i -lt 300 ]; do
    if [ ! -e live/combined.bin ]; then echo VIOLATION-gap; exit 1; fi
    cmp -s live/combined.bin /tmp/A.bin && ok=1 || ok=0
    if [ $ok -eq 0 ]; then cmp -s live/combined.bin /tmp/B.bin && ok=1 || ok=0; fi
    if [ $ok -eq 0 ]; then cmp -s live/combined.bin /tmp/A.bin && ok=1 || ok=0; fi
    if [ $ok -eq 0 ]; then
      s=$(wc -c < live/combined.bin)
      echo "VIOLATION-mixed size=$s"
      exit 1
    fi
    i=$((i+1))
  done
  exit 0
' &
reader=$!
k=0
while [ $k -lt 30 ]; do
  cp /tmp/A.bin live/combined.bin.part && mv live/combined.bin.part live/combined.bin
  cp /tmp/B.bin live/combined.bin.part && mv live/combined.bin.part live/combined.bin
  k=$((k+1))
done
wait $reader
cmp live/combined.bin /tmp/B.bin
echo "atomic replace no torn no gap"

# ---- (4) Batch of BATCH files (4 concurrent workers): copy + append one line to
#      each; after the whole batch finishes, compare everything against the expected
#      final state [scenario2-step5 / scenario2-check4] ----
mkdir -p /tmp/batch live
i=0
while [ $i -lt $BATCH ]; do
  k=$((i+1))
  printf 'batch line %s\n' "$k" > "/tmp/batch/orig-$k.txt"
  { cat "/tmp/batch/orig-$k.txt"; printf 'v2\n'; } > "/tmp/batch/mod-$k.txt"
  i=$((i+1))
done
worker() {
  lo=$1; hi=$2
  j=$lo
  while [ $j -le $hi ]; do
    cp "/tmp/batch/orig-$j.txt" "live/batch-$j.txt.part" \
      && printf 'v2\n' >> "live/batch-$j.txt.part" \
      && mv "live/batch-$j.txt.part" "live/batch-$j.txt"
    j=$((j+1))
  done
}
n=$BATCH; q=$((n/4))
worker 1        $q &
worker $((q+1)) $((2*q)) &
worker $((2*q+1)) $((3*q)) &
worker $((3*q+1)) $n &
wait
i=0
while [ $i -lt $n ]; do
  k=$((i+1)); cmp "live/batch-$k.txt" "/tmp/batch/mod-$k.txt"
  i=$((i+1))
done
echo "batch final state exact"

# ---- Final-state sampling and sync confirmation [scenario2-step5] ----
drive9-test-sample final
drive9-test-drain --mode require-ok --timeout 120s
drive9-test-sample remote-final --as remote

# ---- Verdicts: each assertion below is one case entry in the statistics ----
drive9-test-check manifest-equals --this control --against @final \
    --ignore '.sim/**'                                               --req 'scenario2-check4'
drive9-test-check manifest-equals --this @remote-final --against @final \
    --ignore '.sim/**'                                               --req 'scenario2-check4'
drive9-test-check sync-ok                                            --req 'scenario2-step5'
