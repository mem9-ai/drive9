#!/bin/sh
# Scenario 5 - multiple actors contend for the same asset name.
#
# What this scenario does:
#   When two processes contend for the same path with "do not overwrite"
#   semantics, exactly one succeeds; the loser writes nothing and a
#   pre-existing target stays untouched. Three interfaces each get their own
#   verdict: exclusive create (O_EXCL / set -C), no-clobber link (ln without
#   -f), no-clobber rename (RENAME_NOREPLACE). For each: exactly one wins,
#   the target content equals the winner's source, the loser's source is
#   intact and its path unchanged, and no entrypoint sees a half-written
#   file (no zero bytes / truncation / partial content).
#   Forbidden: application-side protection implemented as "check that it does
#   not exist, then do a plain overwrite write" does not belong here (the
#   actual no-overwrite interface must be used); double success, double
#   failure, or mixed target content are all failures.
#
# Environment (not script logic; supplied via the run CLI):
#   Input: the pre-existing target existing.bin (known content); the two
#   sources /tmp/src-a.bin and /tmp/src-b.bin (content markers src-a / src-b);
#   winner markers and expected texts are constructed locally and
#   independently.
#   control: this script references control (manifest-equals); /tmp scratch
#   is rebuilt on every execution.
set -eu

# ---- Setup: target file, the two sources, winner-marker cleanup
# [scenario5-step1 precondition] ----
printf 'pre-existing content\n' > existing.bin
printf 'src-a %s\n' a    > /tmp/src-a.bin
printf 'src-b %s\n' bbbbbb > /tmp/src-b.bin
mkdir -p installed
rm -f /tmp/winner-a /tmp/winner-b /tmp/ln-winner-a /tmp/ln-winner-b
rm -f installed/cover.bin
rm -f /tmp/rennr.py /tmp/rennr-probe /tmp/ra /tmp/rb /tmp/rn-a /tmp/rn-b

# ---- (1) Two processes race O_EXCL concurrently on the same path, each
# writing its full content only after its own create succeeds; arbitrate that
# exactly one wins [scenario5-step1/scenario5-step2/scenario5-check1/scenario5-check2] ----
( set -C; printf 'branch-a-won\n' > contended.bin ) 2>/dev/null && touch /tmp/winner-a &
( set -C; printf 'branch-b-won\n' > contended.bin ) 2>/dev/null && touch /tmp/winner-b &
wait
a=0; b=0
[ -f /tmp/winner-a ] && a=1
[ -f /tmp/winner-b ] && b=1
[ $((a+b)) -eq 1 ] || { echo "WINNERS=$a$b"; echo "race-create winners=$a$b"; exit 1; }
printf 'branch-a-won\n' > /tmp/exp-a
printf 'branch-b-won\n' > /tmp/exp-b
if [ $a -eq 1 ]; then cmp contended.bin /tmp/exp-a; else cmp contended.bin /tmp/exp-b; fi
echo "exactly-one-winner create"

# ---- (2) Exclusive create against an existing target must fail and must not
# touch its content (byte-identical) [scenario5-step4/scenario5-check3] ----
if ( set -C; printf 'must-not-appear\n' > existing.bin ) 2>/dev/null; then
  echo NOCLOBBER-DID-NOT-FAIL; exit 1
fi
printf 'pre-existing content\n' > /tmp/exp-pre
cmp existing.bin /tmp/exp-pre
echo "noclobber preserves existing"

# ---- (3) No-clobber link race: two processes ln onto the same target at the
# same time (without -f), exactly one succeeds; the loser's source stays
# intact [scenario5-step3/scenario5-check1/scenario5-check4]
# (the sources must first live inside the mount: ln across filesystems is
# EXDEV, so hard-linking straight from /tmp would fail on both sides) ----
cp /tmp/src-a.bin src-a.bin
cp /tmp/src-b.bin src-b.bin
ln src-a.bin installed/cover.bin 2>/dev/null && touch /tmp/ln-winner-a &
ln src-b.bin installed/cover.bin 2>/dev/null && touch /tmp/ln-winner-b &
wait
a=0; b=0
[ -f /tmp/ln-winner-a ] && a=1
[ -f /tmp/ln-winner-b ] && b=1
[ $((a+b)) -eq 1 ] || { echo "LN-WINNERS=$a$b"; exit 1; }
if [ $a -eq 1 ]; then cmp installed/cover.bin src-a.bin; else cmp installed/cover.bin src-b.bin; fi
cmp src-a.bin /tmp/src-a.bin && cmp src-b.bin /tmp/src-b.bin
echo "exactly-one-winner hardlink"

# ---- (4) No-clobber rename race (RENAME_NOREPLACE): if renameat2 is
# unavailable, declare unsupported and record it; if available, both sides
# install onto the same target simultaneously, exactly one succeeds and the
# loser's source stays untouched
# [scenario5-step3/scenario5-check1/scenario5-check4]
# (the segment may end early with exit 0 -> carried by a subshell) ----
(
cat > /tmp/rennr.py <<'EOF'
import ctypes, os, sys, platform
libc = ctypes.CDLL(None, use_errno=True)
RENAME_NOREPLACE = 1
AT_FDCWD = -100
NR = {"x86_64": 316, "aarch64": 276}.get(platform.machine())
if NR is None:
    print("RENNR-ERRNO-38"); sys.exit(2)
src, dst = sys.argv[1], sys.argv[2]
r = libc.syscall(NR, AT_FDCWD, src.encode(), AT_FDCWD, dst.encode(), RENAME_NOREPLACE)
if r != 0:
    e = ctypes.get_errno()
    print(f"RENNR-ERRNO-{e}")
    sys.exit(2 if e in (22, 38) else 1)   # EINVAL/ENOSYS -> unsupported
print("RENNR-OK")
EOF
mkdir -p noreplace
printf 'nr-a %s\n' a   > noreplace/src-a.bin
printf 'nr-b %s\n' bbb > noreplace/src-b.bin
rm -f noreplace/target.bin noreplace/probe noreplace/probe-src
printf 'probe\n' > noreplace/probe-src
# probe: use a one-shot source file so the contending src-a.bin is not
# consumed; the || keeps the probe from tripping set -e
rc=0
python3 /tmp/rennr.py noreplace/probe-src noreplace/probe >/tmp/rennr-probe 2>&1 || rc=$?
if [ $rc -eq 2 ]; then
  cat /tmp/rennr-probe
  echo "RENAME_NOREPLACE unsupported: $(cat /tmp/rennr-probe)"
  exit 0
fi
if [ $rc -eq 0 ]; then rm -f noreplace/probe noreplace/probe-src; fi
python3 /tmp/rennr.py noreplace/src-a.bin noreplace/target.bin >/tmp/ra 2>&1 && touch /tmp/rn-a &
python3 /tmp/rennr.py noreplace/src-b.bin noreplace/target.bin >/tmp/rb 2>&1 && touch /tmp/rn-b &
wait
a=0; b=0
[ -f /tmp/rn-a ] && a=1
[ -f /tmp/rn-b ] && b=1
[ $((a+b)) -eq 1 ] || { echo "RN-WINNERS=$a$b"; exit 1; }
if [ $a -eq 1 ]; then cmp noreplace/target.bin noreplace/src-a.bin && [ -f noreplace/src-b.bin ]; \
else cmp noreplace/target.bin noreplace/src-b.bin && [ -f noreplace/src-a.bin ]; fi
echo "exactly-one-winner rename-noreplace"
)

# ---- Final-state sampling and sync confirmation [scenario5-step5] ----
drive9-test-sample final
drive9-test-drain --mode require-ok --timeout 120s

# ---- Verdicts: each assertion = one case entry in the statistics ----
# Entries under noreplace/ depend on whether renameat2(RENAME_NOREPLACE) is
# supported -- local ext4 supports it while FUSE may not, in which case the
# two file sets are naturally asymmetric (probe leftovers / the target file);
# they stay out of the full-tree comparison.
# contended.bin/installed/ hold race-winner files from two processes: the
# winner's content is inherently nondeterministic (either side can win across
# runs), so a cross-run manifest comparison does not apply; the in-segment
# exactly-one-winner check plus the winner-content comparison already cover
# the scenario 5 semantics.
drive9-test-check manifest-equals --this control --against @final \
    --ignore '.sim/**,noreplace/**,contended.bin,installed/**'      --req 'scenario5-step5'
