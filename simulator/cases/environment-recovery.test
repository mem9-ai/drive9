#!/bin/sh
# Scenario 12 - recover project files after pause, restart, and environment
# replacement.
#
# What this scenario does:
#   A dirty workspace (including uncommitted changes) is preserved per file,
#   exactly, under three recovery modes; after recovery, reading, writing,
#   and syncing keep working. Three legs: leg 1 pause and resume in place
#   (SIGSTOP/SIGCONT-level pause, processes not killed); leg 2 client restart
#   (same cache); leg 3 clean environment (no original cache, no rebuild
#   scripts triggered).
#   What is checked: files confirmed as saved are exactly what they were
#   before recovery (path / type / size / digest / declared attributes all
#   equal; not being committed to git does not affect content preservation);
#   files confirmed deleted do not revive; completed renames keep their
#   result (the old path no longer exists); each of the three recovery modes
#   passes on its own, and the clean environment does not depend on the old
#   local cache; after recovery the directory keeps supporting normal reads,
#   writes, and sync (no pending tasks affect subsequent operations).
#   Forbidden: running init / install / build scripts after recovery and only
#   then verifying (the bare verification must come first); testing one leg
#   and extrapolating to the others (each leg gets its own verdict).
#   Faults: not applicable (sudden exits at different sync states are covered
#   systematically elsewhere; all three legs here recover after sync was
#   confirmed, plus the pause/resume form).
#
#   The three recovery legs: pause-resume / client-restart / clean-env (this
#   script chains the three legs in sequence).
#   Pinned tools: git (optional), coreutils.
#   control: not applicable (recovery semantics have no local counterpart).
#   Input: a seeded project (fixed tree plus add/modify/delete/rename churn,
#   git-committed and uncommitted dirty state side by side); the pre-exit
#   manifest = the tree itself.
set -eu

# ---- scenario12-step1 - seed: fixed project + add/modify/delete/rename
# churn + git committed/uncommitted side by side; after the drain, pin the
# pre-exit manifest (= the tree itself) ----
mkdir -p proj/src proj/assets
printf 'app committed\n'              > proj/src/app.js
printf 'util committed\n'             > proj/src/util.js
head -c 65536 /dev/zero | tr '\0' 'H' > proj/assets/hero.bin
( cd proj && git init -q && git config user.email t@t && git config user.name t \
  && git add -A && git commit -qm base )
# churn (uncommitted)
printf 'uncommitted new feature\n'    > proj/src/new-feature.js
printf 'app dirty edit\n'             > proj/src/app.js
printf 'doomed legacy\n'              > proj/src/legacy.js
mv proj/src/util.js proj/src/helpers.js
rm proj/src/legacy.js
drive9-test-drain --mode require-ok --timeout 120s
drive9-test-sample pre-exit

# ---- Leg 1 - pause then resume in place (processes not killed): SIGSTOP the
# mount daemon -> hold -> SIGCONT (plain process control inside the script) ----
pids=$(pgrep -f 'drive9.*mount' || true)
[ -n "$pids" ] || { echo "MOUNT-DAEMON-NOT-FOUND"; exit 1; }
echo "$pids" | xargs kill -STOP
echo "paused mount daemon: $pids"
drive9-test-hold --for 3s
# resume: SIGCONT; the mount should keep serving afterwards
pids=$(pgrep -f 'drive9.*mount' || true)
[ -n "$pids" ] && echo "$pids" | xargs kill -CONT
sleep 1
printf 'probe after resume\n' > proj/.resume-probe
cat proj/.resume-probe > /dev/null
rm proj/.resume-probe
echo "resumed, mount serving"

# ---- Leg 1 - bare verification (no init/install/build scripts run):
# paths/contents/uncommitted changes/deleted stay deleted/renames preserved
# [scenario12-step4/step5] ----
printf 'app dirty edit\n'           | cmp - proj/src/app.js
printf 'util committed\n'           | cmp - proj/src/helpers.js
printf 'uncommitted new feature\n'  | cmp - proj/src/new-feature.js
[ ! -e proj/src/legacy.js ] && [ ! -e proj/src/util.js ]
[ -e proj/assets/hero.bin ]
echo "tree verified bare"

# ---- Leg 2 - client restart (same cache) ----
drive9-test-kill client
drive9-test-remount --cache same
cd "$D9_MOUNT"

# ---- Leg 2 - bare verification (same as above) ----
printf 'app dirty edit\n'           | cmp - proj/src/app.js
printf 'util committed\n'           | cmp - proj/src/helpers.js
printf 'uncommitted new feature\n'  | cmp - proj/src/new-feature.js
[ ! -e proj/src/legacy.js ] && [ ! -e proj/src/util.js ]
[ -e proj/assets/hero.bin ]
echo "tree verified bare"

# ---- Leg 3 - clean environment (no original cache); first write only one
# new file (no old-data rebuild triggered) ----
printf 'written after recovery\n' > proj/src/after-recovery.js
drive9-test-drain --mode require-ok --timeout 120s
drive9-test-sample pre-exit-2
drive9-test-kill client
drive9-test-remount --cache fresh
cd "$D9_MOUNT"
drive9-test-sample recovered-fresh

# ---- Continue read/write + sync after recovery (no pending tasks affect
# subsequent operations) [scenario12-step6] ----
printf 'next round after recovery\n' > proj/src/next-round.js
printf 'next round after recovery\n' | cmp - proj/src/next-round.js
printf 'app dirty edit\n'            | cmp - proj/src/app.js
echo "post-recovery readwrite ok"
drive9-test-sample final
drive9-test-drain --mode require-ok --timeout 120s
drive9-test-sample remote-final --as remote

# ---- Verdicts: each assertion = one case entry in the statistics ----
drive9-test-check manifest-equals --this @recovered-fresh --against @pre-exit-2 \
    --ignore '.git/**,.sim/**'                                     --req 'scenario12-check1'
drive9-test-check manifest-absent --this @recovered-fresh \
    --paths 'proj/src/legacy.js,proj/src/util.js'                  --req 'scenario12-check2'
drive9-test-check manifest-contains --this @remote-final --against @final \
    --paths 'proj/src/after-recovery.js,proj/src/next-round.js'    --req 'scenario12-check4'
drive9-test-check sync-ok                                          --req 'scenario12-step6'
